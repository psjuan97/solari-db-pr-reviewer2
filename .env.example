# Solari API key - one key drives the sandbox.  https://console.getsolari.com
SOLARI_API_KEY=slr_live_...

# Anthropic API key - used to propose a fix for a broken statement.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: reuse a snapshot that already has postgres installed, so runs skip
# the one-time apt-get. The first run prints the id to save here.
PG_SNAPSHOT_ID=
